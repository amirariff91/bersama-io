{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "PAYLOAD_SECRET",
    "NEXT_PUBLIC_SERVER_URL",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET_NAME",
    "R2_PUBLIC_URL",
    "RESEND_API_KEY",
    "LISTMONK_URL",
    "LISTMONK_USERNAME",
    "LISTMONK_PASSWORD",
    "ONESIGNAL_APP_ID",
    "ONESIGNAL_REST_API_KEY",
    "NEXT_PUBLIC_GA4_ID",
    "NEXT_PUBLIC_CLARITY_ID",
    "NEXT_PUBLIC_ONESIGNAL_APP_ID"
  ]
}
