# ============================================================
# bersama.io - Environment Variables Template
# Copy this file to .env.local. NEVER commit .env.local.
# ============================================================

# Database (Neon DB - serverless PostgreSQL)
DATABASE_URL=postgresql://<user>:<password>-pooler.neon.tech/<db>?sslmode=require

# Payload CMS
PAYLOAD_SECRET=<generate-with-openssl-rand-hex-32>
NEXT_PUBLIC_SERVER_URL=https://bersama.io

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bersama-media
R2_PUBLIC_URL=https://media.bersama.io

# Resend (transactional email)
RESEND_API_KEY=

# Listmonk (newsletter - HTTP Basic Auth)
LISTMONK_URL=https://mail.bersama.io
LISTMONK_USERNAME=
LISTMONK_PASSWORD=

# OneSignal (push notifications)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# Analytics
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=

# Sentry (error monitoring)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
